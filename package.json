{
  "name": "vidlyrics",
  "private": true,
  "version": "1.0.0",
  "description": "Lyrics Video Studio - turn audio + lyrics into a timed lyric video, entirely in your browser.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "build:app-only": "npm run build:app-only --workspace apps/web",
    "bundle-models": "npm run bundle-models --workspace apps/web",
    "bundle-models:dry-run": "npm run bundle-models:dry-run --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web && npm run typecheck --workspace worker",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build:app-only",
    "test:e2e": "playwright test",
    "test:release-voice": "playwright test --config playwright.release.config.ts",
    "render:native": "node tools/native-render/render.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.39.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
